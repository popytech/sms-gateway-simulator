# Required in production. Use a long random value (32+ chars).
SIMULATOR_SECRET=change-me-with-a-long-random-secret

# Optional. When set, API requests must include Authorization: Bearer <value>.
SIMULATOR_API_KEY=

# Optional separate HMAC secret for webhook signatures.
SIMULATOR_WEBHOOK_SECRET=

# Expose generated OTP codes in API responses. Useful only for simulator demos/tests.
SIMULATOR_EXPOSE_OTP=true
